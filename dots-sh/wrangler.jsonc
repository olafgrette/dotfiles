{
  "name": "dots-sh",
  "compatibility_date": "2026-11-06",
  "routes": [{ "pattern": "dots.oag.sh", "custom_domain": true }],

  // Static-only: no request code, R2, or billable Worker invocations.
  // Do not enable the optional Workers Cache feature for this project.
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
