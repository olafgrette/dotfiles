.DS_Store
.claude/settings.local.json
.agentchattr/

# agent directives: local override, appended by install.sh
UNIVERSAL_AGENT_DIRECTIVES.local.md

# fish
.config/fish/fish_history
.config/fish/fish_variables
.config/fish/fish_plugins
.config/fish/conf.d/local.fish
.config/fish/local.fish
.config/tmux/tmux.local.conf

# zellij: config plugin writes a .bak on every save
.config/zellij/*.bak*
# zellij: third-party plugin wasm, fetched by install.sh
.config/zellij/plugins/

# Dux Shell: machine-specific overrides, including pre-2.0 checkout paths
.config/dms/*.local.json
.config/DankMaterialShell/*.local.json

# opencode: pure local state, AGENTS.md is generated into $HOME by install.sh
.opencode/

# aconf.sh: machine-local shell hook, never shared
aconf.local.sh
# aconfmgr: machine-local declarations and capture output, never shared
aconfmgr/aconfmgr.local
aconfmgr/99-unsorted.sh

# Legacy runtime files remain ignored until install.sh migrates the library link.
.local/lib/node_modules/
.local/bin/codex

# python: test bytecode cache
__pycache__/

# wrangler: local build cache and deploy state
.wrangler/
node_modules/

# Downloaded deployment payloads stay outside Git.
dots-sh/public/
