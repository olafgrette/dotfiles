.DS_Store
.claude/settings.local.json
.agentchattr/

# agent directives: local override, appended by install.sh
UNIVERSAL_AGENT_DIRECTIVES.local.md

# fish
.config/fish/fish_history
.config/fish/fish_variables
.config/fish/fish_plugins
.config/fish/conf.d/local.fish
.config/tmux/tmux.local.conf

# zellij: config plugin writes a .bak on every save
.config/zellij/*.bak*

# opencode: pure local state, AGENTS.md is generated into $HOME by install.sh
.opencode/

# local npm installs (e.g. @openai/codex) land in symlinked .local/lib
.local/lib/node_modules/
.local/bin/codex
