#!/usr/bin/env python3
"""Capture and apply sparse Dux Shell settings and managed plugins."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from typing import Any
from types import SimpleNamespace


REQUIRED = object()
SHARED_DROPIN = "10-dotfiles.json"
LOCAL_DROPIN = "90-dotfiles.local.json"
BLOCKED = {
    "activeDisplayProfile",
    "browserUsageHistory",
    "configVersion",
    "connectedFrameBarStyleBackups",
    "desktopClockDisplayPreferences",
    "displayProfiles",
    "displayPreviousRefreshModes",
    "dmsWindowsFloatingSeeded",
    "enabledGpuPciIds",
    "filePickerUsageHistory",
    "frameScreenPreferences",
    "greeterSyncBaseline",
    "hyprlandOutputSettings",
    "matugenTargetMonitor",
    "niriOutputSettings",
    "screenPreferences",
    "selectedGpuIndex",
    "showOnLastDisplay",
    "systemMonitorDisplayPreferences",
    "systemMonitorGpuPciId",
}


def load_json(path: Path, *, missing: Any = REQUIRED) -> Any:
    if not path.exists():
        if missing is REQUIRED:
            raise FileNotFoundError(path)
        return missing
    with path.open(encoding="utf-8") as stream:
        value = json.load(stream)
    if not isinstance(value, dict):
        raise ValueError(f"{path}: expected a JSON object")
    return value


def atomic_json(path: Path, value: dict[str, Any]) -> bool:
    content = json.dumps(value, indent=2, sort_keys=True) + "\n"
    if path.exists() and path.read_text(encoding="utf-8") == content:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise
    return True


def deep_overlay(base: dict[str, Any], overlay: dict[str, Any]) -> dict[str, Any]:
    result = dict(base)
    for key, value in overlay.items():
        if isinstance(result.get(key), dict) and isinstance(value, dict):
            result[key] = deep_overlay(result[key], value)
        else:
            result[key] = value
    return result


# These lists remain in settings.json in Dux Shell 2.0. Keep their machine fields
# local while allowing the rest of each instance to travel between hosts.
INSTANCE_FIELDS = {
    "barConfigs": {"screenPreferences": None, "showOnLastDisplay": None},
    "dockConfigs": {"screenPreferences": None, "showOnLastDisplay": None},
    "desktopWidgetInstances": {
        "positions": None,
        "config": {"displayPreferences": None, "gpuPciId": None},
    },
}


def machine_fields(value: dict, fields: dict) -> dict:
    return {
        key: machine_fields(value[key], nested) if nested is not None else value[key]
        for key, nested in fields.items()
        if key in value and (nested is None or isinstance(value[key], dict))
    }


def without_machine_fields(value: dict, fields: dict) -> dict:
    return {
        key: without_machine_fields(item, fields[key])
        if key in fields and isinstance(item, dict) else item
        for key, item in value.items()
        if key not in fields or fields[key] is not None
    }


def portable(settings: dict) -> dict:
    result = {key: value for key, value in settings.items() if key not in BLOCKED}
    for key, fields in INSTANCE_FIELDS.items():
        if key in result:
            result[key] = [without_machine_fields(item, fields) for item in result[key]]
    return result


def localize_instances(settings: dict, live: dict) -> dict:
    result = dict(settings)
    for key, fields in INSTANCE_FIELDS.items():
        if key not in result:
            continue
        by_id = {item["id"]: item for item in live.get(key, []) if "id" in item}
        result[key] = [
            deep_overlay(machine_fields(by_id.get(item.get("id"), {}), fields), item)
            for item in result[key]
        ]
    return result


def offer_commit(repo: Path, patch: Path) -> None:
    try:
        relative = patch.resolve().relative_to(repo.resolve())
    except ValueError:
        return
    status = subprocess.run(
        ["git", "status", "--porcelain", "--", str(relative)],
        cwd=repo,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    if not status:
        return

    if status.startswith("??"):
        subprocess.run(
            ["git", "diff", "--no-index", "--", "/dev/null", str(relative)],
            cwd=repo,
            check=False,
        )
    else:
        subprocess.run(
            ["git", "diff", "--no-ext-diff", "HEAD", "--", str(relative)],
            cwd=repo,
            check=True,
        )

    if not sys.stdin.isatty():
        print("Not prompting for commit: stdin is not interactive")
        return
    if input("Commit DMS settings? [y/N] ").strip().lower() not in {"y", "yes"}:
        return

    subprocess.run(["git", "add", "--", str(relative)], cwd=repo, check=True)
    subprocess.run(
        [
            "git",
            "commit",
            "--only",
            "-m",
            "chore(dms): update settings",
            "-m",
            "Capture portable GUI preferences while leaving machine-specific DMS state local.",
            "--",
            str(relative),
        ],
        cwd=repo,
        check=True,
    )


def settings_files(args: argparse.Namespace):
    """Keep auxiliary preferences separate from DMS's main settings schema."""
    yield args, True
    for name in ("clsettings", "plugin_settings"):
        yield SimpleNamespace(
            live=args.live.with_name(f"{name}.json"),
            patch=args.patch.with_name(f"{name}.patch.json"),
            local_patch=args.local_patch.with_name(f"{name}.local.json"),
        ), False


def plugin_lock(path: Path) -> dict:
    lock = load_json(path, missing={"lockfileVersion": 1, "plugins": {}})
    if lock.get("lockfileVersion") != 1 or not isinstance(lock.get("plugins"), dict):
        raise ValueError(f"{path}: expected a version 1 DMS plugin lockfile")
    if not all(isinstance(entry, dict) for entry in lock["plugins"].values()):
        raise ValueError(f"{path}: expected plugin objects")
    return lock


def run_plugins(args: argparse.Namespace, *command: str) -> None:
    # DMS resolves plugins through XDG_CONFIG_HOME, not its shell UI --config flag.
    config = args.live.absolute().parent
    if config.name != "dms":
        raise ValueError("plugin operations require --live inside a dms directory; "
                         "use --settings-only for other paths")
    subprocess.run(["dms", "plugins", *command], check=True,
                   env={**os.environ, "XDG_CONFIG_HOME": str(config.parent)})


def capture_plugins(args: argparse.Namespace) -> tuple[Path, dict]:
    target = args.patch.with_name("plugins.lock.json")
    shared = plugin_lock(target)
    local = plugin_lock(args.local_patch.with_name("plugins.lock.local.json"))
    with tempfile.TemporaryDirectory(prefix="dms-plugins-") as directory:
        exported = Path(directory) / "plugins.lock.json"
        run_plugins(args, "lock", "--output", str(exported))
        if not exported.exists():
            raise FileNotFoundError(exported)
        captured = plugin_lock(exported)
    # Keep private plugins out of Git and preserve shared revisions hidden locally.
    captured["plugins"] = {
        key: value for key, value in captured["plugins"].items()
        if key not in local["plugins"]
    }
    captured["plugins"].update({
        key: value for key, value in shared["plugins"].items()
        if key in local["plugins"]
    })
    return target, captured


def restore_plugins(args: argparse.Namespace) -> None:
    target = args.patch.with_name("plugins.lock.json")
    local = args.local_patch.with_name("plugins.lock.local.json")
    if not target.exists() and not local.exists():
        return
    shared = plugin_lock(target)
    overrides = plugin_lock(local)
    # Replace whole entries: a local repo must not inherit a shared monorepo path.
    desired = {**shared, "plugins": {**shared["plugins"], **overrides["plugins"]}}
    with tempfile.TemporaryDirectory(prefix="dms-plugins-") as directory:
        merged = Path(directory) / "plugins.lock.json"
        atomic_json(merged, desired)
        # Extra installed plugins remain local. DMS validates and restores revisions.
        run_plugins(args, "restore", str(merged))


def settings_dropins(args: argparse.Namespace):
    return sorted((args.live.parent / "config.d").glob("*.json"))


def effective_settings(args: argparse.Namespace) -> dict:
    # Match Dux's native top-level precedence, including whole arrays/objects.
    settings = load_json(args.live, missing={})
    for path in settings_dropins(args):
        settings.update(load_json(path))
    return settings


def local_settings_keys(args: argparse.Namespace) -> set[str]:
    keys = set(load_json(args.local_patch, missing={}))
    for path in settings_dropins(args):
        if path.name != SHARED_DROPIN:
            keys.update(load_json(path))
    return keys


def capture(args: argparse.Namespace) -> int:
    captures = []
    for paths, primary in settings_files(args):
        if not primary and not paths.live.exists():
            continue
        if primary:
            if not paths.live.exists() and not settings_dropins(paths):
                raise FileNotFoundError(paths.live)
            live = portable(effective_settings(paths))
            local_keys = local_settings_keys(paths)
        else:
            live = load_json(paths.live)
            local_keys = set(load_json(paths.local_patch, missing={}))
        shared = load_json(paths.patch, missing={})
        if primary:
            shared = portable(shared)
        patch = {
            key: value
            for key, value in live.items()
            if key not in local_keys
        }
        # This machine cannot capture shared values hidden by local overrides.
        patch.update({key: value for key, value in shared.items() if key in local_keys})
        captures.append((paths.patch, patch))

    if not args.settings_only:
        captures.append(capture_plugins(args))

    # Validate every source before changing any tracked file.
    for path, patch in captures:
        changed = atomic_json(path, patch)
        print(f"Captured {path.name}"
              + ("" if changed else " (unchanged)"))
    for path, _ in captures:
        offer_commit(Path(__file__).resolve().parents[2], path)
    return 0


def apply_file(args: argparse.Namespace, primary: bool = True) -> int:
    shared = load_json(args.patch, missing={})
    local_patch = load_json(args.local_patch, missing={})
    live = load_json(args.live, missing={})
    if primary:
        directory = args.live.parent / "config.d"
        shared_path = directory / SHARED_DROPIN
        local_path = directory / LOCAL_DROPIN
        shared = portable(shared)
        # Native precedence cannot merge individual bar/dock instances. Keep
        # their machine fields in the writable live copy, never the Git source.
        desired = localize_instances(shared, effective_settings(args))
        owned = (set(load_json(shared_path, missing={})) | set(shared)
                 | set(load_json(local_path, missing={})) | set(local_patch))
        # Remove duplicate owned values from the base so deleting a shared key
        # cannot expose an obsolete pre-migration value. Other base keys stay local.
        base = {key: value for key, value in live.items() if key not in owned}
        atomic_json(shared_path, desired)
        atomic_json(local_path, local_patch)
        atomic_json(args.live, base)
        print(f"Applied DMS native drop-ins to {directory}")
        return 0
    live_changed = atomic_json(args.live, deep_overlay(shared, local_patch))
    if live_changed:
        print(f"Applied DMS settings to {args.live}")
    return 0


def apply(args: argparse.Namespace, *, allow_migration: bool = True) -> int:
    if not allow_migration and not (args.live.parent / "config.d" / SHARED_DROPIN).is_file():
        raise ValueError("native Dux drop-ins need foreground migration: "
                         "run dms-settings apply, then dms restart")
    files = [(paths, primary) for paths, primary in settings_files(args)
             if primary or paths.patch.exists() or paths.local_patch.exists()
             or paths.live.exists()]
    # A malformed auxiliary file must not leave an earlier file applied.
    for paths, primary in files:
        for path in (paths.patch, paths.local_patch, paths.live):
            load_json(path, missing={})
    effective_settings(args)
    # Leave settings untouched if plugin validation or restoration fails.
    if not args.settings_only:
        restore_plugins(args)
    for paths, primary in files:
        apply_file(paths, primary)
    return 0


def parser() -> argparse.ArgumentParser:
    repo = Path(__file__).resolve().parents[2]
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "dms"
    result = argparse.ArgumentParser(
        description=__doc__,
        epilog="Apply publishes native config.d drop-ins from shared settings and local overrides. "
               "Capture writes current portable settings back to the patches. Also handles sibling "
               "clsettings, plugin_settings and plugins.lock files. Plugin restore may use the "
               "network and retains extra installed plugins. Restart DMS once after creating config.d.",
    )
    result.add_argument("--live", type=Path, default=config / "settings.json")
    result.add_argument("--patch", type=Path, default=repo / ".config/dms/settings.patch.json")
    result.add_argument("--local-patch", type=Path, default=repo / ".config/dms/settings.local.json")
    result.add_argument("--settings-only", action="store_true",
                        help="skip plugin lock capture/restore (used by background installation)")
    result.add_argument("--no-migrate", action="store_true",
                        help="refuse initial native drop-in migration (background installation)")
    result.add_argument("command", choices=("apply", "capture"))
    return result


def migrate_local_overrides(repo: Path) -> None:
    # Git moves the shared patches, but ignored overrides stay at the old path
    # on other checkouts. Validate all destinations before moving any override.
    moves = []
    for name in ("settings", "clsettings", "plugin_settings", "plugins.lock"):
        source = repo / f".config/DankMaterialShell/{name}.local.json"
        target = repo / f".config/dms/{name}.local.json"
        if not source.exists() and not source.is_symlink():
            continue
        if target.exists() or target.is_symlink():
            raise ValueError(f"local override migration conflict: {source} and {target}; both preserved")
        moves.append((source, target))
    for source, target in moves:
        target.parent.mkdir(parents=True, exist_ok=True)
        source.rename(target)


def main() -> int:
    args = parser().parse_args()
    try:
        repo = Path(__file__).resolve().parents[2]
        if args.local_patch == repo / ".config/dms/settings.local.json":
            migrate_local_overrides(repo)
        return capture(args) if args.command == "capture" else apply(args, allow_migration=not args.no_migrate)
    except (OSError, ValueError, json.JSONDecodeError, subprocess.CalledProcessError) as error:
        print(f"dms-settings: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
