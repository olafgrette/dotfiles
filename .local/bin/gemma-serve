#!/bin/bash
# gemma-serve — 31B Gemma with 192k context
source "$HOME/.local/lib/llama-common.sh"

llama_parse_mode "$@"
if [ "$_llama_mode_consumed" = 1 ]; then shift; fi

# Model-specific
MODEL_HF="unsloth/gemma-4-31B-it-qat-GGUF:UD-Q4_K_XL"
DEFAULT_CTX=196608
CTX="${CTX:-$DEFAULT_CTX}"

TOP_P=0.95
TOP_K=64
MIN_P=0.00
EXTRA_ARGS=()

# Mode-specific templating (Gemma enables thinking explicitly)
case "$MODE" in
    coding)
        TEMP=0.6
        EXTRA_ARGS+=(--chat-template-kwargs '{"enable_thinking":true}')
        ;;
    general)
        TEMP=1.0
        EXTRA_ARGS+=(--chat-template-kwargs '{"enable_thinking":true}')
        ;;
    no-think)
        TEMP=0.7
        TOP_P=0.8
        EXTRA_ARGS+=(--chat-template-kwargs '{"enable_thinking":false}')
        ;;
esac

llama_init_platform

echo "Starting gemma-4-31B-it-qat in '$MODE' mode with ${CTX} context${OFFLOAD_NOTE}..."

SERVER_BIN=$(llama_find_server)
exec "$SERVER_BIN" \
    -hf "$MODEL_HF" \
    --ctx-size "$CTX" \
    --temp "$TEMP" \
    --top-p "$TOP_P" \
    --top-k "$TOP_K" \
    --min-p "$MIN_P" \
    --n-gpu-layers 99 \
    --parallel 1 \
    --flash-attn on \
    --fit off \
    --cache-type-k q4_0 \
    --cache-type-v q4_0 \
    -cram 16384 \
    --no-mmap \
    "${PLATFORM_ARGS[@]}" \
    "${EXTRA_ARGS[@]}" \
    "$@"
