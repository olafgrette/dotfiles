#!/bin/bash
# qwen-fast-serve — Q4_K_M with MTP draft for speed
source "$HOME/.local/lib/llama-common.sh"

llama_parse_mode "$@"
if [ "$_llama_mode_consumed" = 1 ]; then shift; fi

MODEL_REPO="unsloth/Qwen3.6-35B-A3B-MTP-GGUF"
MODEL_FILE="Qwen3.6-35B-A3B-UD-Q4_K_M.gguf"

DEFAULT_CTX=132768
CTX="${CTX:-$DEFAULT_CTX}"

TOP_P=0.95
TOP_K=20
MIN_P=0.00
EXTRA_ARGS=()

llama_init_platform
llama_apply_mode_temps

echo "Starting Qwen3.6-35B-A3B in '$MODE' mode with ${CTX} context${OFFLOAD_NOTE}..."

SERVER_BIN=$(llama_find_server)
exec "$SERVER_BIN" \
    --hf-repo "$MODEL_REPO" \
    --hf-file "$MODEL_FILE" \
    --ctx-size "$CTX" \
    --temp "$TEMP" \
    --top-p "$TOP_P" \
    --top-k "$TOP_K" \
    --min-p "$MIN_P" \
    --spec-type draft-mtp --spec-draft-n-max 2 \
    --n-gpu-layers 99 \
    --parallel 1 \
    --flash-attn on \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --fit off \
    -cram 16384 \
    --no-mmap \
    "${PLATFORM_ARGS[@]}" \
    "${EXTRA_ARGS[@]}" \
    "$@"
